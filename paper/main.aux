\newlabel{fig:overview-a}{{1a}{2}{One frozen checkpoint for immune--protein complexes: TCR--pMHC, antibody--antigen, nanobody--antigen and protein--protein inputs map to a shared grammar-conditioned ESMC$\rightarrow $LLaDA diffusion model that feeds ten downstream tasks.\relax }{figure.caption.1}{}}
\newlabel{fig:overview-a@cref}{{[subfigure][1][1]1a}{[1][1][]2}}
\newlabel{sub@fig:overview-a}{{a}{2}{One frozen checkpoint for immune--protein complexes: TCR--pMHC, antibody--antigen, nanobody--antigen and protein--protein inputs map to a shared grammar-conditioned ESMC$\rightarrow $LLaDA diffusion model that feeds ten downstream tasks.\relax }{figure.caption.1}{}}
\newlabel{sub@fig:overview-a@cref}{{[subfigure][1][1]1a}{[1][1][]2}}
\newlabel{fig:overview-b}{{1b}{2}{Designed grammar-v2 token format. Entity blocks (\texttt {<prots>}{\ldots }\texttt {<protd>}) carry an optional type tab and residue span; relation tokens join blocks. Grey residues are fixed context; orange residues are diffusion targets.\relax }{figure.caption.1}{}}
\newlabel{fig:overview-b@cref}{{[subfigure][2][1]1b}{[1][1][]2}}
\newlabel{sub@fig:overview-b}{{b}{2}{Designed grammar-v2 token format. Entity blocks (\texttt {<prots>}{\ldots }\texttt {<protd>}) carry an optional type tab and residue span; relation tokens join blocks. Grey residues are fixed context; orange residues are diffusion targets.\relax }{figure.caption.1}{}}
\newlabel{sub@fig:overview-b@cref}{{[subfigure][2][1]1b}{[1][1][]2}}
\newlabel{fig:overview-c}{{1c}{2}{Training forward pass. Noisy tokens are read two ways: ESMC encodes each chain (corruption-mirrored) into boxed residue features that replace embeddings at residue sites, while structure/relation tokens keep token embeddings; the fused stream enters a bidirectional LLaDA trained with masked cross-entropy on target residues.\relax }{figure.caption.1}{}}
\newlabel{fig:overview-c@cref}{{[subfigure][3][1]1c}{[1][1][]2}}
\newlabel{sub@fig:overview-c}{{c}{2}{Training forward pass. Noisy tokens are read two ways: ESMC encodes each chain (corruption-mirrored) into boxed residue features that replace embeddings at residue sites, while structure/relation tokens keep token embeddings; the fused stream enters a bidirectional LLaDA trained with masked cross-entropy on target residues.\relax }{figure.caption.1}{}}
\newlabel{sub@fig:overview-c@cref}{{[subfigure][3][1]1c}{[1][1][]2}}
\newlabel{fig:overview-d}{{1d}{2}{Inference: confidence-ordered iterative unmasking. Fixed context (\texttt {<prots>}/\texttt {<tcr>}/\texttt {<protd>} and conditioning residues) stays visible while masked target sites are revealed from high- to low-confidence.\relax }{figure.caption.1}{}}
\newlabel{fig:overview-d@cref}{{[subfigure][4][1]1d}{[1][1][]2}}
\newlabel{sub@fig:overview-d}{{d}{2}{Inference: confidence-ordered iterative unmasking. Fixed context (\texttt {<prots>}/\texttt {<tcr>}/\texttt {<protd>} and conditioning residues) stays visible while masked target sites are revealed from high- to low-confidence.\relax }{figure.caption.1}{}}
\newlabel{sub@fig:overview-d@cref}{{[subfigure][4][1]1d}{[1][1][]2}}
